// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Asset {
 id        String   @id
 code      String
 name      String
 type      String
 market    String
 isActive  Boolean
 createdAt String

 transactions Transaction[]
 dividends    Dividend[]
}

model Transaction {
 id        String @id
 assetId   String
 date      String
 action    String
 shares    Float
 price     Float
 fee       Float
 tax       Float
 note      String
 createdAt String

 asset Asset @relation(fields: [assetId], references: [id])
}

model Dividend {
 id               String @id
 assetId          String
 exDividendDate   String
 paymentDate      String
 dividendPerShare Float
 shares           Float
 totalDividend    Float
 withholdingTax   Float
 handlingFee      Float
 status           String
 source           String
 note             String
 createdAt        String

 asset Asset @relation(fields: [assetId], references: [id])
}
